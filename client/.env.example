# ==============================================================================
# CodePulse Frontend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Production Deployment (e.g. Vercel Environment Variables)
# Backend: Railway
# ------------------------------------------------------------------------------
VITE_API_URL=https://codepulse-production-577a.up.railway.app
VITE_WS_URL=wss://codepulse-production-577a.up.railway.app/ws

# ------------------------------------------------------------------------------
# Local Development Defaults (uncomment to override localhost defaults)
# ------------------------------------------------------------------------------
# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080/ws

# Note:
# - VITE_API_BASE_URL is also supported as a fallback (e.g., http://localhost:8080/api).
# - Trailing slashes and '/api' paths are normalized automatically to prevent '/api/api'.
# - WebSocket connections automatically upgrade to wss:// in production.
